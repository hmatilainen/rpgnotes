{% extends 'base.html.twig' %}

{% block title %}{% if query %}Search: {{ query }}{% else %}Search{% endif %} — RPG Notes{% endblock %}

{% block body %}
    <h1 class="search-page-heading">Search</h1>

    <form method="get" action="{{ path('search') }}" class="search-page-form" role="search">
        <input type="search" name="q" value="{{ query }}" placeholder="Search notes…" aria-label="Search notes" autofocus>
        <button type="submit" class="btn btn-small">Search</button>
    </form>

    {% if query == '' %}
        <p class="search-empty">Enter a search to find session reports and lore notes.</p>
    {% elseif hits is empty %}
        <p class="search-empty">No notes matched “{{ query }}”.</p>
    {% else %}
        <ul class="search-results">
            {% for hit in hits %}
                <li>
                    <a href="{{ hit.url }}" class="search-result-title">{{ hit.title }}</a>
                    <span class="search-result-path">{{ hit.path }}</span>
                    {% if hit.excerpt %}
                        <p class="search-result-excerpt">{{ hit.excerpt }}</p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
