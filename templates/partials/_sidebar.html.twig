<ul>
    {% for folder in node.folders %}
        {% set folderPath = path is not empty ? path ~ '/' ~ folder.name : folder.name %}
        <li>
            <details data-path="{{ folderPath }}">
                <summary>
                    <span class="sidebar-folder-label">
                        <span class="sidebar-folder-icons">
                            {% include 'partials/_icon.html.twig' with { name: 'folder', class: 'icon icon--sm sidebar-icon-folder-closed' } only %}
                            {% include 'partials/_icon.html.twig' with { name: 'folder-open', class: 'icon icon--sm sidebar-icon-folder-open' } only %}
                        </span>
                        <span>{{ folder.name }}</span>
                    </span>
                </summary>
                {% include 'partials/_sidebar.html.twig' with {
                    node: folder,
                    depth: depth + 1,
                    path: folderPath,
                    activeNoteSlug: activeNoteSlug ?? null,
                } %}
            </details>
        </li>
    {% endfor %}
    {% for note in node.notes %}
        <li class="sidebar-note">
            <a href="/notes/{{ note.slug }}"{% if activeNoteSlug is defined and activeNoteSlug == note.slug %} class="is-active"{% endif %}>
                {% include 'partials/_icon.html.twig' with { name: 'file-text', class: 'icon icon--sm' } only %}
                <span>{{ note.title }}</span>
            </a>
        </li>
    {% endfor %}
</ul>
