{% extends 'base.html.twig' %}

{% block title %}AI access — RPG Notes{% endblock %}

{% block body %}
    <h1>Connect your AI assistant</h1>
    <p class="form-intro">Use these campaign notes in Claude, ChatGPT, Mistral Le Chat, or Cursor — without scraping the website.</p>

    <section class="ai-access-panel">
        <h2>Claude (web)</h2>
        <p>Copy these into Claude → <strong>Settings → Connectors → Add custom connector</strong> (expand <strong>Advanced settings</strong> for Client ID and Secret).</p>

        <div class="snippet-block">
            <label>Remote MCP server URL</label>
            <code class="copy-snippet">{{ connector_url }}</code>
        </div>
        <div class="snippet-block">
            <label>OAuth Client ID</label>
            <code class="copy-snippet">{{ claude_client_id }}</code>
        </div>
        <p class="form-hint">The Client ID is fixed for your account — copy it once. Generating a secret below does not change it.</p>

        {% if flash_claude_secret %}
            <div class="flash-success token-reveal">
                <p><strong>OAuth Client Secret</strong> — copy it now. It will not be shown again.</p>
                <code class="copy-snippet">{{ flash_claude_secret }}</code>
            </div>
        {% endif %}

        <form method="post" action="{{ path('ai_access_claude_credentials') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('ai_access_claude_credentials') }}">
            <button type="submit" class="btn">{{ flash_claude_secret ? 'Regenerate Client Secret' : 'Generate Client Secret' }}</button>
        </form>
        <p class="form-hint">After adding the connector in Claude, your browser will open this site to log in and approve access.</p>

        <ol class="instruction-list">
            <li>Paste the three values above into Claude’s custom connector form.</li>
            <li>Click <strong>Add</strong> in Claude and complete the allow prompt on this site.</li>
            <li>Enable the connector in a chat and ask about session reports or lore.</li>
        </ol>
    </section>

    <section class="ai-access-panel">
        <h2>API token (Mistral, Cursor, ChatGPT)</h2>
        <div class="snippet-block">
            <label>Connector URL</label>
            <code class="copy-snippet">{{ connector_url }}</code>
        </div>

        {% if flash_token %}
            <div class="flash-success token-reveal">
                <p><strong>New API token</strong> — copy it now. It will not be shown again.</p>
                <code class="copy-snippet">{{ flash_token }}</code>
            </div>
        {% endif %}

        <form method="post" action="{{ path('ai_access_token') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('ai_access_token') }}">
            <button type="submit" class="btn">{{ flash_token ? 'Regenerate token' : 'Generate API token' }}</button>
        </form>
        <p class="form-hint">Treat the token like a password. Regenerating invalidates the old one — update your AI app settings after regenerating.</p>
    </section>

    {% if flash_token %}
        <section class="ai-access-panel">
            <h2>Cursor <code>mcp.json</code></h2>
            <pre class="snippet-pre"><code>{
  "mcpServers": {
    "forgotten-realms": {
      "url": "{{ connector_url }}",
      "headers": {
        "Authorization": "Bearer {{ flash_token }}"
      }
    }
  }
}</code></pre>
        </section>
    {% endif %}

    <section class="ai-access-panel">
        <h2>ChatGPT</h2>
        <p><strong>Free account:</strong> no — needs Plus, Pro, Business, Enterprise, or Edu.</p>
        <ol class="instruction-list">
            <li>Enable <strong>Developer mode</strong> under Settings → Apps & Connectors.</li>
            <li>Add a custom connector with the <strong>Connector URL</strong>.</li>
            <li>Authentication: <strong>Token</strong> — paste your API token.</li>
        </ol>
    </section>

    <section class="ai-access-panel">
        <h2>Mistral Le Chat</h2>
        <p><strong>Free account:</strong> yes.</p>
        <ol class="instruction-list">
            <li>Sidebar → <strong>Intelligence → Connectors</strong>.</li>
            <li><strong>Custom MCP Connector</strong> → paste the <strong>Connector URL</strong> exactly (<code>{{ connector_url }}</code>).</li>
            <li>When authentication is detected, choose <strong>Bearer token</strong> and paste your API token (not your site login password).</li>
            <li>If connection fails after a few tries, delete the connector and add it again with a fresh token.</li>
        </ol>
    </section>

    <section class="ai-access-panel">
        <h2>Example questions</h2>
        <ul>
            <li>“Summarize the last three session reports.”</li>
            <li>“What happened in report 90?”</li>
            <li>“What do we know about Deerwater?”</li>
        </ul>
    </section>
{% endblock %}
