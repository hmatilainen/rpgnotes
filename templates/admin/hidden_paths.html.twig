{% extends 'base.html.twig' %}

{% block title %}Hidden paths — Admin — RPG Notes{% endblock %}

{% block body %}
    <h1>Hidden paths</h1>
    <p>Folders or individual files, relative to the vault root. You can paste the vault path, note slug, or site URL.</p>
    <p class="form-hint">Examples: <code>A - GM</code>, <code>People/Aidan - Watchful Order's Night Watch Agent.md</code>, <code>people/aidan-watchful-order-s-night-watch-agent</code>, or <code>/notes/people/aidan-watchful-order-s-night-watch-agent</code>. Run sync after adding.</p>

    <form method="post" action="{{ path('admin_hidden_paths_add') }}">
        <div class="form-group">
            <label for="path">Path</label>
            <input type="text" id="path" name="path" required>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('admin_hidden_paths_add') }}">
        <button type="submit" class="btn">Add</button>
    </form>

    <ul class="hidden-paths-list">
        {% for hiddenPath in hiddenPaths %}
            <li>
                <span>{{ hiddenPath.path }}</span>
                <form method="post" action="{{ path('admin_hidden_paths_remove', {id: hiddenPath.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_hidden_paths_remove') }}">
                    <button type="submit" class="btn">Remove</button>
                </form>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
