# Copy to .env.local on the server (never commit .env.local).
#
#   cp .env.prod.example .env.local
#   nano .env.local

###> symfony/framework-bundle ###
APP_SECRET=change-me-to-a-long-random-string
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://notes.example.com
###< symfony/routing ###

# Personal fine-grained PAT embedded in the HTTPS URL (see README).
VAULT_REPO_URL=https://<username>:<PAT>@github.com/<owner>/<vault-repo>.git

# Bearer token the vault repo's GitHub Action sends to /webhook/sync
SYNC_WEBHOOK_SECRET=change-me-to-a-long-random-string

###> doctrine/doctrine-bundle ###
# POSTGRES_PASSWORD must match the password in DATABASE_URL below.
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://app:change-me@db:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
